# =============================================================
# ScamShield AI — .gitignore
# Rules: never commit secrets, virtual envs, generated
#        artifacts, editor noise, or local OS detritus.
#        Approved project Markdown files are NOT excluded.
# =============================================================

# ── Python virtual environment ────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# ── Python bytecode & caches ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Testing & coverage artefacts ──────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.log

# ── Trained model artefacts ───────────────────────────────────
# Versioned production baseline model artifact:
!app/models/text_model.joblib
app/models/*.pkl
app/models/*.bin

# ── Raw & processed datasets ──────────────────────────────────
data/raw/
# Versioned processed benchmark splits for CI/test reproducibility:
!data/processed/*.csv
!data/synthetic/

# ── IDE & editor noise ────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Windows OS noise ──────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Databases & local snapshots ───────────────────────────────
*.db
*.sqlite3
data/backups/

# ── Misc ──────────────────────────────────────────────────────
*.DS_Store
*.bak
*.swp
*.tmp
dist/
build/
*.egg-info/

