# ==============================================================================
# ScamShield AI — Production Environment Variables Configuration (.env.production)
# ==============================================================================
# Copy this file to .env in your production environment and customize all values.
# NEVER commit the production .env file to public version control.

# ------------------------------------------------------------------------------
# 1. Application Identity & Runtime Mode
# ------------------------------------------------------------------------------
APP_NAME=ScamShield AI
APP_VERSION=1.0.0
APP_ENV=production
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Server & Network Binding
# ------------------------------------------------------------------------------
# In production behind Nginx/ALB, bind to loopback 127.0.0.1 or internal private interface
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# ------------------------------------------------------------------------------
# 3. Trusted Reverse Proxies (Critical Security Setting)
# ------------------------------------------------------------------------------
# Comma-separated list of IP addresses or CIDR blocks of your upstream reverse proxies.
# Only requests originating directly from these addresses will have their X-Forwarded-For
# or X-Real-IP headers honored.
#
# Examples:
# - Local Nginx on same server: "127.0.0.1,::1"
# - AWS Application Load Balancer in VPC: "10.0.0.0/16"
# - Cloudflare Proxies (enter Cloudflare IP ranges): "173.245.48.0/20,103.21.244.0/22,..."
# - Direct public exposure (no proxy): "" (empty disables header forwarding trust)
TRUSTED_PROXIES=127.0.0.1,::1

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of trusted frontend origins allowed to make API requests.
# Do NOT use '*' in production if cookies or authentication are passed.
CORS_ORIGINS=https://scamshield.yourdomain.com,https://app.yourdomain.com

# ------------------------------------------------------------------------------
# 5. Cryptography & Session Authentication
# ------------------------------------------------------------------------------
# High-entropy random secret key for HMAC token signing.
# Generate via: openssl rand -hex 32
AUTH_SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_HEX_KEY

# Token expiration duration in seconds (86400 = 24 hours)
TOKEN_EXPIRY_SECONDS=86400

# ------------------------------------------------------------------------------
# 6. Rate Limiting Defense
# ------------------------------------------------------------------------------
# Maximum analysis requests permitted per client IP per 60-second sliding window
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 7. Payload Security Boundaries
# ------------------------------------------------------------------------------
MAX_TEXT_LENGTH=10000
MAX_URL_LENGTH=2048

# ------------------------------------------------------------------------------
# 8. Detection Scoring Thresholds (0-100 scale)
# ------------------------------------------------------------------------------
VERDICT_SCAM_THRESHOLD=75
VERDICT_REVIEW_THRESHOLD=35

# ------------------------------------------------------------------------------
# 9. Filesystem Paths (Optional Overrides)
# ------------------------------------------------------------------------------
# Leave empty to use default locations relative to repository root.
# SCAMSHIELD_DB_PATH=/var/lib/scamshield/scamshield.db
# SCAMSHIELD_BACKUP_DIR=/var/backups/scamshield
